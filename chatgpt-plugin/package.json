{
  "name": "jl-engine-chatgpt-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "start:http": "node dist/index.js --http",
    "dev:http": "tsx src/index.ts --http",
    "test": "vitest run",
    "smoke": "tsx src/smoke.ts",
    "smoke:mcp": "tsx src/mcp-smoke.ts",
    "inspect": "npx @modelcontextprotocol/inspector http://127.0.0.1:3001/mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
